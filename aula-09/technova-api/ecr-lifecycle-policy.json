{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Remove imagens sem tag 1 dia depois do push",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 1
      },
      "action": { "type": "expire" }
    },
    {
      "rulePriority": 2,
      "description": "Mantem apenas os 15 builds sha- mais recentes",
      "selection": {
        "tagStatus": "tagged",
        "tagPatternList": ["sha-*"],
        "countType": "imageCountMoreThan",
        "countNumber": 15
      },
      "action": { "type": "expire" }
    }
  ]
}
