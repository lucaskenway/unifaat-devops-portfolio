+++ b/aula-09/technova-api/orders-report.js
@@ -0,0 +1,12 @@
+const db = require('./db');
+const logger = require('./logger');
+
+module.exports = async (req) => {
+  const id = parseInt(req.query.id, 10);
+  try {
+    return await db.query('SELECT * FROM orders WHERE id = $1', [id]);
+  } catch (err) {
+    logger.error({ err, id }, 'falha ao gerar relatório de pedidos');
+    throw err;
+  }
+};
