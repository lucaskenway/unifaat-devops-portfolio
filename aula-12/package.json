{
  "name": "technova-api",
  "version": "1.3.0",
  "description": "TechNova API - Sistema de gestão de pedidos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --coverage --forceExit",
    "test:ci": "jest --coverage --forceExit --ci",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "echo 'Build step - verificação de sintaxe' && node --check server.js",
    "migrate:up": "node migrations/cli.js up",
    "migrate:down": "node migrations/cli.js down",
    "migrate:status": "node migrations/cli.js status"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server.js",
      "src/**/*.js",
      "routes/**/*.js",
      "migrations/runner.js"
    ]
  }
}
