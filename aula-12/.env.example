PORT=3000
NODE_ENV=development

# Feature Flags (prefixo FF_) — trocar o valor e reiniciar o container desliga a feature
FF_NEW_SHIPPING_CALC=true
FF_BULK_ORDERS=false
FF_AI_RECOMMENDATIONS=false
FF_NEW_CHECKOUT=false

# CloudWatch (na EC2 as credenciais vêm do LabInstanceProfile)
METRICS_ENABLED=false
AWS_REGION=us-east-1

# Migrações
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/technova
